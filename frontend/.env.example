# ============================================================================
# Storeye frontend (Vite) environment configuration — shareable template.
#
#   Copy to:  frontend/.env        (Vite loads `.env` from the frontend dir)
#   Command:  cp frontend/.env.example frontend/.env
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# These are BUILD-TIME values: re-run `npm run build` (or restart `npm run dev`)
# after changing them. Never put secrets here — they ship to the browser.
# ============================================================================

# Local FastAPI "Edge Hub" base URL. Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000                  # [OPTIONAL]

# --- Demo login / showcase identity (DEMO ONLY — no real authentication) ---
# The backend has NO auth endpoint today; these only prefill the demo sign-in.
VITE_DEMO_STORE=Storeye Mart                        # [DEMO ONLY]
VITE_DEMO_USER=Rohan Verma                           # [DEMO ONLY]
VITE_DEMO_ROLE=Store Manager                         # [DEMO ONLY]
VITE_DEMO_EMAIL=demo@storeye.local                  # [DEMO ONLY]
VITE_DEMO_PASSWORD=StoreyeDemo@123                  # [DEMO ONLY] change for shared demos
# Shared guard sent to demo mutating endpoints; must match backend DEMO_RESET_KEY.
VITE_DEMO_RESET_KEY=storeye-demo-reset              # [DEMO ONLY]
