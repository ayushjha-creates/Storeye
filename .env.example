# ============================================================================
# Storeye environment configuration (shareable template — NO real secrets).
#
#   Copy to:  backend/.env        (the backend reads `.env` from its own dir)
#   Command:  cp .env.example backend/.env
#
# Labels used below:
#   [REQUIRED]         must be set for the app to run
#   [OPTIONAL]         has a safe default; set only to override
#   [DEVELOPMENT ONLY] must NOT be used as-is in production
#   [DEMO ONLY]        only meaningful for the demo store/scenarios
#
# Never commit a real `.env` or real credentials. `.env` is git-ignored.
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
APP_NAME=Storeye                                    # [OPTIONAL]
APP_VERSION=0.1.0                                   # [OPTIONAL]
DEBUG=true                                          # [DEVELOPMENT ONLY] false in production
# development | test | production
ENVIRONMENT=development                             # [OPTIONAL] production => strict startup
# true forces startup to fail on bad config/unreachable DB/schema-behind-head.
STRICT_STARTUP=false                                # [DEVELOPMENT ONLY] true in production

# ----------------------------------------------------------------------------
# DATABASE  (local PostgreSQL — the ONLY supported business database)
# ----------------------------------------------------------------------------
# SQLite is rejected by config validation (legacy SQLite is diagnostics-only).
# Local default uses the project-local cluster on port 5433 with trust auth.
DATABASE_URL=postgresql+psycopg2://storeye@localhost:5433/storeye   # [REQUIRED]

# Test database (used by the backend test suite; never the business DB).
TEST_DATABASE_URL=postgresql+psycopg2://storeye@localhost:5433/storeye_test  # [DEVELOPMENT ONLY]

# ----------------------------------------------------------------------------
# API SERVER / CORS / LOGGING
# ----------------------------------------------------------------------------
HOST=0.0.0.0                                        # [OPTIONAL]
PORT=8000                                           # [OPTIONAL]
# JSON array (pydantic-settings list syntax), http(s) origins only.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]   # [OPTIONAL]
LOG_LEVEL=INFO                                      # [OPTIONAL] DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s   # [OPTIONAL]

# ----------------------------------------------------------------------------
# CAMERA / INGESTION (defaults applied per camera unless overridden)
# ----------------------------------------------------------------------------
CAMERA_FRAME_SKIP=5                                 # [OPTIONAL]
SHELF_CHECK_INTERVAL_SEC=15.0                       # [OPTIONAL]
GAP_PERSISTENCE_WINDOW_SEC=30.0                     # [OPTIONAL]
SYNC_AGGREGATION_INTERVAL_SEC=60.0                  # [OPTIONAL]

# ----------------------------------------------------------------------------
# AI — ANONYMOUS RE-ID (no faces, no biometrics, no cloud)
# ----------------------------------------------------------------------------
REID_ENABLED=true                                   # [OPTIONAL]
# stub (tests) | torch (default, ResNet18 ImageNet) | openvino (optional Intel OMZ)
REID_PROVIDER=torch                                 # [OPTIONAL]
REID_SIMILARITY_THRESHOLD=0.72                      # [OPTIONAL] 0..1
REID_HIGH_CONFIDENCE_SCORE=0.86                     # [OPTIONAL] 0..1, >= similarity
REID_MAX_TIME_GAP_SECONDS=120.0                     # [OPTIONAL]
GLOBAL_PERSON_TIMEOUT_SECONDS=1800.0                # [OPTIONAL]
REID_UPDATE_INTERVAL_SECONDS=10.0                   # [OPTIONAL]
# Same-camera re-acquisition (M27): reconnect a re-created local track to its
# prior global id, so one physical person -> one local track -> one journey.
# Only fires when the person is alone on the camera, the absence is short, and
# the appearance match is strong. Concurrent tracks are never merged.
REID_SAME_CAMERA_REACQUISITION=true                 # [OPTIONAL]
REID_SAME_CAMERA_REACQUISITION_SECONDS=2.0          # [OPTIONAL] min absence before reconnect
REID_SAME_CAMERA_REACQUISITION_MAX_GAP_SECONDS=15.0 # [OPTIONAL] max absence before new session
REID_SAME_CAMERA_SIMILARITY_THRESHOLD=0.85          # [OPTIONAL] 0..1, stricter than cross-camera
# Torch provider weights. Default resolves to the torchvision cache:
#   ~/.cache/torch/hub/checkpoints/resnet18-f37072fd.pth
# Set only to point at a pre-staged offline copy. NEVER downloaded at runtime.
#REID_TORCH_WEIGHTS_PATH=/absolute/path/to/resnet18-f37072fd.pth   # [OPTIONAL]
# OpenVINO provider (REID_PROVIDER=openvino): set the OMZ model path + install
# the optional `openvino` package. Not required for the default torch provider.
#REID_OV_MODEL_PATH=/absolute/path/to/person-reidentification-retail-0287   # [OPTIONAL]

# ----------------------------------------------------------------------------
# EDGE RUNTIME — CAMERA CAPACITY (M27)
# ----------------------------------------------------------------------------
# Max cameras that may run at once on this Edge node (0 = unlimited). Starting
# beyond capacity is refused with a clear 409 rather than overloading the box.
EDGE_MAX_CAMERAS=8                                   # [OPTIONAL]

# ----------------------------------------------------------------------------
# EDGE RUNTIME — PERSON ANALYTICS + CACHE (M29)
# ----------------------------------------------------------------------------
# Hot in-memory person-state cache (Layer A): how long a cached person state
# survives while unseen (seconds), and a soft LRU capacity bound. The cache is
# memory-only; PostgreSQL holds only the minimal durable analytics below.
PERSON_CACHE_TTL_SECONDS=86400                       # [OPTIONAL] 24h
PERSON_CACHE_MAX_ENTRIES=2048                        # [OPTIONAL] 0 = unlimited
# Durable journey/session/zone analytics are purged after this many days
# (scripts/purge_analytics.py). never touches inventory/batches/bills.
PERSON_ANALYTICS_RETENTION_DAYS=30                   # [OPTIONAL]
# A local track must be seen this many CONSECUTIVE frames before expensive
# person work runs (Re-ID association, cache promotion, zone/journey events);
# 5 filters 1-frame detector blips that otherwise mint a ghost visitor each.
# A per-camera stable_track_min_frames > 1 wins over this global floor.
PERSON_STABLE_TRACK_MIN_FRAMES=5                     # [OPTIONAL]
# PER-FRAME PERSON observation rows (the M13/M14/M19 camera dashboards use
# these) are throttled by the per-camera min gap and purged after this many
# hours. Set false for pure cache-only person analytics on long-running,
# high-traffic deployments.
PERSON_OBSERVATION_PERSISTENCE=true                  # [OPTIONAL]
PERSON_OBSERVATION_RETENTION_HOURS=24                # [OPTIONAL]
# Global AI-processing cap (frames/sec) per camera unless overridden per
# camera; 0 = uncapped. Capture is NOT throttled — the live stream stays fluid
# and the AI processes the latest frame on time.
AI_TARGET_FPS=0                                      # [OPTIONAL]

# ----------------------------------------------------------------------------
# AI — MODEL ASSETS (local files; validated by `storeye models`)
# ----------------------------------------------------------------------------
# Person detector (Ultralytics YOLO11n) and shelf/product model live under the
# repo `models/` directory and are resolved relative to the project root. They
# are NOT configurable via env today; see docs/model_assets.md.
#   models/yolo/yolo11n.pt        person detection
#   models/shelf/shelf_model.pt   shelf/product detection
# PaddleOCR downloads its official models on first use (bootstrap only).

# ----------------------------------------------------------------------------
# INVENTORY / STORE INTELLIGENCE thresholds (rule-based, deterministic)
# ----------------------------------------------------------------------------
LOW_STOCK_THRESHOLD=10                              # [OPTIONAL]
EXPIRY_WARNING_DAYS=30                              # [OPTIONAL]
EXPIRING_SOON_DAYS=30                               # [OPTIONAL]
HIGH_TRAFFIC_MIN_VISITS=50                          # [OPTIONAL]
HIGH_TRAFFIC_VISITS_FACTOR=1.5                      # [OPTIONAL]
HIGH_DWELL_MIN_SECONDS=180                          # [OPTIONAL]
HIGH_DWELL_MIN_VISITS=5                             # [OPTIONAL]
HIGH_SELLING_MIN_UNITS=20                           # [OPTIONAL]
HIGH_SELLING_SALES_WINDOW_HOURS=168                 # [OPTIONAL]
INSIGHT_CAMERA_STALE_MINUTES=60                     # [OPTIONAL]
INSIGHT_TRAFFIC_WINDOW_HOURS=24                     # [OPTIONAL]
INSIGHT_DWELL_WINDOW_HOURS=24                       # [OPTIONAL]
INSIGHT_REFRESH_INTERVAL_SECONDS=300                # [OPTIONAL]
INSIGHT_EXPIRY_TTL_HOURS=48                         # [OPTIONAL]
# INFO|LOW|MEDIUM|HIGH|CRITICAL — insights at/above this create/refresh alerts.
INSIGHT_TO_ALERT_SEVERITY=HIGH                      # [OPTIONAL]

# ----------------------------------------------------------------------------
# AUTHENTICATION  (server-side sessions + RBAC)
# ----------------------------------------------------------------------------
# HttpOnly cookie carrying the opaque session secret. Passwords are stored as
# Argon2id hashes; the raw session secret is hashed in the DB and never logged.
AUTH_COOKIE_NAME=storeye_session                    # [OPTIONAL]
# Set true when serving over HTTPS so the cookie is only sent over TLS.
AUTH_COOKIE_SECURE=false                            # [OPTIONAL] true behind HTTPS
AUTH_COOKIE_SAMESITE=lax                            # [OPTIONAL] lax|strict|none
AUTH_SESSION_TTL_HOURS=12                           # [OPTIONAL] session lifetime
AUTH_PASSWORD_MIN_LENGTH=8                          # [OPTIONAL] >= 8
# Login throttling: max failed attempts per (email, client) inside the window.
AUTH_LOGIN_MAX_ATTEMPTS=8                           # [OPTIONAL]
AUTH_LOGIN_THROTTLE_SECONDS=900                     # [OPTIONAL]
# Custom header required on auth mutations (CSRF defense; the frontend sends it).
AUTH_CSRF_HEADER=X-Storeye-CSRF                     # [OPTIONAL]
AUTH_CSRF_VALUE=1                                   # [OPTIONAL]

# ----------------------------------------------------------------------------
# DEMO MODE  (demo store + scenario engine)
# ----------------------------------------------------------------------------
DEMO_MODE=true                                      # [DEMO ONLY] false disables demo routes
# Shared guard for demo mutating endpoints (reset/activate).
DEMO_RESET_KEY=storeye-demo-reset                   # [DEMO ONLY] change or blank for shared deploys

# ----------------------------------------------------------------------------
# MOBILE-TO-EDGE USB INTAKE (M25)  [OPTIONAL — safe defaults]
# ----------------------------------------------------------------------------
# Directory a phone is copied into over USB; the watcher polls it and feeds
# each new photo to the existing M17 scan pipeline. Empty => `<data>/intake`.
#STOREYE_INTAKE_DIR=/absolute/path/to/intake           # [OPTIONAL]
INTAKE_MAX_MB=15                                      # [OPTIONAL] photo size ceiling (matches M17 cap)
INTAKE_STABILITY_SECONDS=2.0                          # [OPTIONAL] pause after copy stops growing
INTAKE_WATCH_INTERVAL_SECONDS=1.0                     # [OPTIONAL] watcher poll cadence
INTAKE_RETENTION_DAYS=7                               # [OPTIONAL] processed/failed sweep age (active review files kept)

# ----------------------------------------------------------------------------
# SMS BILL RECEIPTS (M31)  [OPTIONAL — defaults OFF]
# ----------------------------------------------------------------------------
# When enabled, a bill created for a customer WITH a mobile number automatically
# queues a receipt; a background worker delivers it via MSG91 and retries on
# failure. Billing is NEVER blocked — enqueueing is atomic with the bill write.
#SMS_ENABLED=true                                      # [OPTIONAL] master switch (default false)
SMS_PROVIDER=msg91                                    # [OPTIONAL] only msg91 is wired today
#MSG91_AUTH_KEY=your_auth_key                         # [REQUIRED IF SMS_ENABLED] provider key
#MSG91_SENDER_ID=ABCDEF                               # [OPTIONAL] 6-char alphanumeric sender id
MSG91_ROUTE=4                                         # [OPTIONAL] 4 = transactional
MSG91_COUNTRY_CODE=91                                 # [OPTIONAL] default 91 (India)
#MSG91_BASE_URL=https://control.msg91.com             # [OPTIONAL] override only in tests
SMS_POLL_SECONDS=5.0                                  # [OPTIONAL] worker poll cadence
SMS_MAX_ATTEMPTS=5                                    # [OPTIONAL] delivery tries before FAILED
SMS_RETRY_BACKOFF_SECONDS=60.0                        # [OPTIONAL] exponential backoff base
SMS_STALE_CLAIM_SECONDS=30.0                          # [OPTIONAL] crashed SENDING claim re-claim age
SMS_TIMEOUT_SECONDS=10.0                              # [OPTIONAL] gateway request timeout

# ----------------------------------------------------------------------------
# LEGACY DIAGNOSTICS (SQLite health/ready/metrics only — NOT a business DB)
# ----------------------------------------------------------------------------
#EDGERETAIL_DATA_DIR=/absolute/path/to/data          # [OPTIONAL]
#EDGERETAIL_DB_PATH=/absolute/path/to/edgeretail.db  # [OPTIONAL]
