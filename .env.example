# Storeye environment configuration (shareable template — NO real secrets).
# Copy to backend/.env and set local values.

# --- Server ---
APP_NAME=Storeye
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL data layer (Storeye business entities) ---
# Local dev default (trust auth, project-local Postgres on port 5433).
# Never commit real credentials.
DATABASE_URL=postgresql+psycopg2://storeye@localhost:5433/storeye